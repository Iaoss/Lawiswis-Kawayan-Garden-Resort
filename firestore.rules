rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Note: the server code in /apiHandlers uses the Firebase Admin SDK, which
    // ignores these rules. These rules only limit what a browser can do.

    // ── Helpers ─────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    // Deactivated users (status == 'inactive') get no role, so they are locked out.
    function userRole() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) && get(path).data.get('status', 'active') != 'inactive'
        ? get(path).data.role
        : null;
    }
    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }
    function isReceptionist() {
      return isSignedIn() && userRole() == 'receptionist';
    }
    function isStaff() {
      return isAdmin() || isReceptionist();
    }
    // Extra access an admin gave a receptionist (users/{uid}.access), for a
    // set time or until removed. See src/lib/staffAccess.js.
    function hasAccess(feature) {
      let grant = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('access', {}).get(feature, null);
      return isReceptionist() && grant != null
        && (grant.get('expiresAt', null) == null || grant.expiresAt > request.time);
    }
    function isAdminOr(feature) {
      return isAdmin() || hasAccess(feature);
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ── Users ───────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId
            && changedKeys().hasOnly(['name', 'settings', 'avatar'])
            && (!('avatar' in request.resource.data)
                || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 60)));
      allow delete: if isAdmin();
    }

    // ── Activity log ────────────────────────────────────────
    // Most entries are written by the server. Staff may add an entry only
    // for themselves (e.g. a room status change), stamped with the server
    // time. Nobody can edit or delete entries; only admins can read them.
    match /activityLogs/{logId} {
      allow read: if isAdminOr('activity');
      allow create: if isStaff()
        && request.resource.data.staffUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['action', 'summary', 'reservationId', 'guestName', 'details', 'staffUid', 'staffName', 'staffEmail', 'staffRole', 'createdAt'])
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 300;
      allow update, delete: if false;
    }

    // ── FAQs / quick replies (staff chat) ───────────────────
    match /faqs/{faqId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }
    match /quickReplies/{replyId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    // ── Rooms ───────────────────────────────────────────────
    // Room prices set walk-in totals, so only admins can change them.
    // Receptionists can only change a room's status (e.g. mark it cleaned).
    match /rooms/{roomId} {
      allow read: if true;
      allow update: if isAdmin() || (isReceptionist() && changedKeys().hasOnly(['status']));
      allow create, delete: if isAdmin();
    }

    // ── Reservations ────────────────────────────────────────
    // Everything that changes money or status goes through the server:
    // guest bookings (/api/create-reservation), walk-ins, payments, charges
    // and policy cancellations (/api/staff-billing), and status changes,
    // overstays and late fees (/api/reservation-status). From the browser,
    // staff can only raise or clear a cancellation request.
    match /reservations/{reservationId} {
      allow read: if isStaff();
      allow create: if false;
      allow update: if isStaff()
        && changedKeys().hasOnly([
             'cancellationRequested', 'cancellationRequestedBy', 'cancellationRequestedAt', 'cancellationReason',
           ])
        && !(isReceptionist() && resource.data.get('status', '') == 'cancelled');
      allow delete: if isAdmin();
    }

    // ── Staff notifications (e.g. overstay alerts) ──────────
    match /notifications/{notificationId} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // ── Contact inquiries (created by the server) ───────────
    match /contacts/{contactId} {
      allow read: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
      allow create: if false;
    }

    // ── Newsletter subscribers (created by the server) ──────
    match /subscribers/{subscriberId} {
      allow read: if isStaff();
      allow update, delete: if isAdmin();
      allow create: if false;
    }
    match /newsletterSubscribers/{subscriberId} {
      allow read: if isStaff();
      allow update: if isAdminOr('feedback');
      allow delete: if isAdmin();
      allow create: if false;
    }

    // ── Payments ────────────────────────────────────────────
    // Only the server records payments: counter payments through
    // /api/staff-billing (capped at the balance owed), online payments after
    // PayMongo confirms them. Payment history can't be edited from a browser.
    match /payments/{paymentId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    // ── Tasks ───────────────────────────────────────────────
    match /tasks/{taskId} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // ── Promos & Discounts ──────────────────────────────────
    match /promoCodes/{code} {
      allow read: if isStaff();
      allow create, update, delete: if isAdminOr('promos');
    }
    match /promos/{promoId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdminOr('promos');
    }

    // ── Activities (old dashboard log, no longer shown) ─────
    match /activities/{activityId} {
      allow read: if isStaff();
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // ── Settings ────────────────────────────────────────────
    match /settings/{settingId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ── News ────────────────────────────────────────────────
    match /news/{articleId} {
      allow read: if isStaff()
        || resource.data.status == 'published';
      allow create, update, delete: if isAdminOr('news');
    }

    // ── Feedback ────────────────────────────────────────────
    // Guests submit feedback through the server (/api/submit-feedback), which
    // validates it, so browsers can't write here directly.
    match /feedback/{feedbackId} {
      allow create: if false;
      allow read, update: if isStaff();
      allow delete: if isAdmin();
    }

    // ── Email (admin only) ──────────────────────────────────
    match /emails/{emailId} {
      allow read: if isAdmin();
      allow update: if isAdmin() && changedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    // ── Conversations (guest chat via Firebase Anonymous Auth) ──
    match /conversations/{conversationId} {

      function validConversationCreate() {
        let d = request.resource.data;
        return isSignedIn()
          && d.keys().hasOnly(['guestName', 'guestPhone', 'guestUid', 'lastMessage', 'lastMessageAt', 'unread'])
          && d.keys().hasAll(['guestName', 'guestPhone', 'guestUid', 'lastMessage', 'unread'])
          && d.guestUid == request.auth.uid
          && d.guestName is string
          && d.guestName.size() <= 80
          && d.guestPhone is string
          && d.guestPhone.size() <= 20
          && d.lastMessage is string
          && d.lastMessage.size() <= 2000
          && d.unread is bool;
      }

      function isOwner() {
        return isSignedIn() && resource.data.guestUid == request.auth.uid;
      }

      function validConversationUpdate() {
        let incoming = request.resource.data;
        let existing = resource.data;
        return incoming.diff(existing).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'unread'])
          && incoming.guestName == existing.guestName
          && incoming.guestPhone == existing.guestPhone
          && incoming.guestUid == existing.guestUid
          && incoming.lastMessage is string
          && incoming.lastMessage.size() <= 2000;
      }

      allow read: if isStaff() || isOwner();
      allow create: if isStaff() || validConversationCreate();
      allow update: if isStaff() || (isOwner() && validConversationUpdate());
      allow delete: if isAdmin();

      match /messages/{messageId} {

        function ownsParent() {
          return isSignedIn()
            && get(/databases/$(database)/documents/conversations/$(conversationId)).data.guestUid == request.auth.uid;
        }

        function validGuestMessage() {
          let d = request.resource.data;
          return d.keys().hasOnly(['text', 'sender', 'timestamp'])
            && d.sender == 'guest'
            && d.text is string
            && d.text.size() > 0
            && d.text.size() <= 2000;
        }

        allow read: if isStaff() || ownsParent();
        allow create: if isStaff() || (ownsParent() && validGuestMessage());
        allow update, delete: if isStaff();
      }
    }

    // ── Staff search across every conversation's messages ───
    // The sidebar search reads all messages at once (a "collection group"
    // query), which needs its own rule. Staff only, read only.
    match /{path=**}/messages/{messageId} {
      allow read: if isStaff();
    }

    // ── Default deny ────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
