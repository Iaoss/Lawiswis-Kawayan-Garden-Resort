{
  "crons": [
    { "path": "/api/arrival-reminders", "schedule": "0 1 * * *" }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(lawiswis-logo.png|favicon.ico|logo192.png|logo512.png|manifest.json)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
