# Copy this file to .env.local for local development, and set the same
# names in Vercel → Project → Settings → Environment Variables.
#
# Everything here is SERVER-ONLY: it is read by /api (Vercel functions) and
# never sent to the browser. Don't rename any of these to REACT_APP_...,
# because Create React App puts every REACT_APP_ variable into the public
# website code.
#
# Never commit .env.local (it's in .gitignore).

# Firebase Admin (Firebase console → Project settings → Service accounts → Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Gmail account that sends booking emails (use a Google "app password", not the real password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# PayMongo (dashboard → Developers): secret key and webhook signing secret
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Vercel cron password for /api/arrival-reminders (any long random text)
CRON_SECRET=

# Public address of the site, used in email and payment return links
PUBLIC_SITE_URL=https://lawiswis-kawayan-garden-resort.vercel.app

# Cloudinary photo uploads (dashboard → Settings → API Keys). With the key and
# secret set, uploads are signed by the server; you can then delete the old
# unsigned upload preset in Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Only used until the key and secret above are set:
CLOUDINARY_UPLOAD_PRESET=

# Local build setting (not a secret): don't publish source maps.
GENERATE_SOURCEMAP=false
